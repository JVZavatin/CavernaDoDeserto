; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Caverna Do Deserto"
config/description="Projeto dedicado ao trabalho de conclusão de curso 2."
config/version="0.1"
run/main_scene="res://start_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://Sprites/icon.svg"

[autoload]

Events="*res://Resources/Events.gd"
SaveManager="*res://SaveManager.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/mode=2
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"

